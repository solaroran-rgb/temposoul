{
  "name": "tarot-meanings",
  "file": "src/data/tarot/card-meanings.ts",
  "entries": [
    {
      "id": "major-0.name",
      "zh": "愚者"
    },
    {
      "id": "major-0.upright",
      "zh": "新阶段的开启，鼓励以开放、未被经验束缚的心态迈出第一步，接受计划之外的变化。"
    },
    {
      "id": "major-0.reversed",
      "zh": "准备不足：不是不能出发，而是需要先看清脚下的路，避免把鲁莽误当作勇气。"
    },
    {
      "id": "major-0.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-1.name",
      "zh": "魔术师"
    },
    {
      "id": "major-1.upright",
      "zh": "你需要的条件大多已具备，关键在于聚焦与执行，把已有资源串成具体行动。"
    },
    {
      "id": "major-1.reversed",
      "zh": "精力分散或夸大其词，能量未落到具体事情上，需要收敛注意力。"
    },
    {
      "id": "major-1.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-2.name",
      "zh": "女祭司"
    },
    {
      "id": "major-2.upright",
      "zh": "答案已在内心，只是尚未到说出口的时机，适合先向内看、留出安静时间。"
    },
    {
      "id": "major-2.reversed",
      "zh": "忽视内在声音，或被表面的信息牵着走，需要重新听自己的直觉。"
    },
    {
      "id": "major-2.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-3.name",
      "zh": "女皇"
    },
    {
      "id": "major-3.upright",
      "zh": "付出正在积累成果，适合以长期心态培育人与事，关注生活中的滋养来源。"
    },
    {
      "id": "major-3.reversed",
      "zh": "过度付出或照料失衡，需要先照顾好自己，再谈照顾他人。"
    },
    {
      "id": "major-3.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-4.name",
      "zh": "皇帝"
    },
    {
      "id": "major-4.upright",
      "zh": "需要建立清晰规则与边界，用纪律把想法变成可执行的框架。"
    },
    {
      "id": "major-4.reversed",
      "zh": "控制欲过强或规则僵化，需要从独断退回协商，学会授权。"
    },
    {
      "id": "major-4.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-5.name",
      "zh": "教皇"
    },
    {
      "id": "major-5.upright",
      "zh": "适合寻求经验者的建议，或回到被验证过的方法上，体系化地学习。"
    },
    {
      "id": "major-5.reversed",
      "zh": "规则已不合时宜，需要审视是否只是惯性在维持，而非真正有用。"
    },
    {
      "id": "major-5.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-6.name",
      "zh": "恋人"
    },
    {
      "id": "major-6.upright",
      "zh": "需要按真实的价值取向做选择，而非只权衡得失；把选择说清楚。"
    },
    {
      "id": "major-6.reversed",
      "zh": "价值不一致或回避选择，导致关系与事情悬而未决。"
    },
    {
      "id": "major-6.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-7.name",
      "zh": "战车"
    },
    {
      "id": "major-7.upright",
      "zh": "把相互拉扯的两股能量统一方向，坚持前进即可取胜。"
    },
    {
      "id": "major-7.reversed",
      "zh": "方向打架或用力过猛，先对齐目标再加速。"
    },
    {
      "id": "major-7.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-8.name",
      "zh": "力量"
    },
    {
      "id": "major-8.upright",
      "zh": "真正的力量是不被情绪牵着走，用平静与耐心化解对抗。"
    },
    {
      "id": "major-8.reversed",
      "zh": "自我怀疑或情绪失控，先稳住自己再处理外部。"
    },
    {
      "id": "major-8.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-9.name",
      "zh": "隐者"
    },
    {
      "id": "major-9.upright",
      "zh": "适合暂时抽离人群，独自想清楚自己真正要的方向。"
    },
    {
      "id": "major-9.reversed",
      "zh": "过度孤立或逃避，需要在独处与求助之间找平衡。"
    },
    {
      "id": "major-9.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-10.name",
      "zh": "命运之轮"
    },
    {
      "id": "major-10.upright",
      "zh": "局势正朝有利方向转动，适合抓住变化的节点顺势而为。"
    },
    {
      "id": "major-10.reversed",
      "zh": "低谷或逆行，不必硬扛，等待轮子转回来。"
    },
    {
      "id": "major-10.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-11.name",
      "zh": "正义"
    },
    {
      "id": "major-11.upright",
      "zh": "需要以事实而非情绪下判断，结果会对应你过去的选择。"
    },
    {
      "id": "major-11.reversed",
      "zh": "不公、推卸或自欺，需直面自己该承担的部分。"
    },
    {
      "id": "major-11.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-12.name",
      "zh": "倒吊人"
    },
    {
      "id": "major-12.upright",
      "zh": "主动停下不是浪费，换个角度会看见之前忽略的答案。"
    },
    {
      "id": "major-12.reversed",
      "zh": "无谓牺牲或僵持，需要决定是继续等还是抽身。"
    },
    {
      "id": "major-12.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-13.name",
      "zh": "死神"
    },
    {
      "id": "major-13.upright",
      "zh": "一个旧阶段必须结束，彻底告别才能腾出空间给新事物。"
    },
    {
      "id": "major-13.reversed",
      "zh": "抗拒结束、卡在过渡里，拖延只会更耗。"
    },
    {
      "id": "major-13.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-14.name",
      "zh": "节制"
    },
    {
      "id": "major-14.upright",
      "zh": "需要在对立之间找平衡，用耐心与分寸把事情慢慢调顺。"
    },
    {
      "id": "major-14.reversed",
      "zh": "失衡或极端，检查哪里用力过猛或过犹不及。"
    },
    {
      "id": "major-14.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-15.name",
      "zh": "恶魔"
    },
    {
      "id": "major-15.upright",
      "zh": "看清自己正被某种欲望或旧习惯牵制，锁链其实可松可解。"
    },
    {
      "id": "major-15.reversed",
      "zh": "开始挣脱枷锁，决心切断不健康的依附。"
    },
    {
      "id": "major-15.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-16.name",
      "zh": "塔"
    },
    {
      "id": "major-16.upright",
      "zh": "建立在错误基础上的东西会骤然变化，摧毁即解脱。"
    },
    {
      "id": "major-16.reversed",
      "zh": "拖延着不愿面对的崩塌，勉强维持只会更痛。"
    },
    {
      "id": "major-16.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-17.name",
      "zh": "星星"
    },
    {
      "id": "major-17.upright",
      "zh": "经历动荡后重获内心平静，相信长期方向并温柔疗愈自己。"
    },
    {
      "id": "major-17.reversed",
      "zh": "失落信心或脱离现实，需要把期待拉回可实现处。"
    },
    {
      "id": "major-17.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-18.name",
      "zh": "月亮"
    },
    {
      "id": "major-18.upright",
      "zh": "信息不完整、前路有迷雾，宜相信直觉但不急于下结论。"
    },
    {
      "id": "major-18.reversed",
      "zh": "迷雾散去、误解澄清，藏着的真相逐渐浮出。"
    },
    {
      "id": "major-18.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-19.name",
      "zh": "太阳"
    },
    {
      "id": "major-19.upright",
      "zh": "局面明朗乐观，努力被看见，适合大方地享受成果。"
    },
    {
      "id": "major-19.reversed",
      "zh": "短暂乌云或过度乐观，别得意忘形即可转好。"
    },
    {
      "id": "major-19.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-20.name",
      "zh": "审判"
    },
    {
      "id": "major-20.upright",
      "zh": "适合复盘过往，与过去和解后回应更高一层的召唤。"
    },
    {
      "id": "major-20.reversed",
      "zh": "苛责自己或迟迟不肯放下旧伤，需宽恕方能前行。"
    },
    {
      "id": "major-20.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "major-21.name",
      "zh": "世界"
    },
    {
      "id": "major-21.upright",
      "zh": "一个阶段圆满完成，你已整合所学，准备好开启下一圈。"
    },
    {
      "id": "major-21.reversed",
      "zh": "差最后一步没收尾，或迟迟不愿结束而拖延。"
    },
    {
      "id": "major-21.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-0.name",
      "zh": "权杖Ace"
    },
    {
      "id": "minor-权杖-0.upright",
      "zh": "一个新想法带着足够的热量出现，适合尽快做小规模尝试。"
    },
    {
      "id": "minor-权杖-0.reversed",
      "zh": "热情未找到出口，或启动后缺乏持续供给。"
    },
    {
      "id": "minor-权杖-0.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-1.name",
      "zh": "权杖2"
    },
    {
      "id": "minor-权杖-1.upright",
      "zh": "你已站稳脚跟，适合站在高处权衡全局、选定下一个方向。"
    },
    {
      "id": "minor-权杖-1.reversed",
      "zh": "计划脱离现实或害怕走出舒适区。"
    },
    {
      "id": "minor-权杖-1.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-2.name",
      "zh": "权杖3"
    },
    {
      "id": "minor-权杖-2.upright",
      "zh": "前期布局开始起效，适合等待回报并远眺下一程。"
    },
    {
      "id": "minor-权杖-2.reversed",
      "zh": "计划受阻或方向过早，需调整节奏。"
    },
    {
      "id": "minor-权杖-2.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-3.name",
      "zh": "权杖4"
    },
    {
      "id": "minor-权杖-3.upright",
      "zh": "一段努力换来安稳与庆祝，适合与亲友共享成果。"
    },
    {
      "id": "minor-权杖-3.reversed",
      "zh": "安稳中暗藏变动，或庆祝被琐事冲淡。"
    },
    {
      "id": "minor-权杖-3.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-4.name",
      "zh": "权杖5"
    },
    {
      "id": "minor-权杖-4.upright",
      "zh": "竞争与意见冲撞在所难免，在混战中找到自己的节奏。"
    },
    {
      "id": "minor-权杖-4.reversed",
      "zh": "冲突缓和或你在刻意回避必要的争执。"
    },
    {
      "id": "minor-权杖-4.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-5.name",
      "zh": "权杖6"
    },
    {
      "id": "minor-权杖-5.upright",
      "zh": "努力被公开认可，适合带着荣誉继续往前走。"
    },
    {
      "id": "minor-权杖-5.reversed",
      "zh": "虚名或胜利被打折，警惕骄傲。"
    },
    {
      "id": "minor-权杖-5.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-6.name",
      "zh": "权杖7"
    },
    {
      "id": "minor-权杖-6.upright",
      "zh": "你占住高位，需要扛住压力捍卫已有位置。"
    },
    {
      "id": "minor-权杖-6.reversed",
      "zh": "防守吃力或战线过长，考虑战略性后撤。"
    },
    {
      "id": "minor-权杖-6.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-7.name",
      "zh": "权杖8"
    },
    {
      "id": "minor-权杖-7.upright",
      "zh": "事情突然加速，消息与机会很快到来，顺势快行。"
    },
    {
      "id": "minor-权杖-7.reversed",
      "zh": "计划延误或信息混乱，减速核对。"
    },
    {
      "id": "minor-权杖-7.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-8.name",
      "zh": "权杖9"
    },
    {
      "id": "minor-权杖-8.upright",
      "zh": "你已付出很多，再坚持一下就能守住底线。"
    },
    {
      "id": "minor-权杖-8.reversed",
      "zh": "精疲力竭或戒备过度，需要休整。"
    },
    {
      "id": "minor-权杖-8.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-9.name",
      "zh": "权杖10"
    },
    {
      "id": "minor-权杖-9.upright",
      "zh": "你承担过多，快到目的地了但快被压垮。"
    },
    {
      "id": "minor-权杖-9.reversed",
      "zh": "该卸下重担或学会委托，别什么都自己扛。"
    },
    {
      "id": "minor-权杖-9.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-10.name",
      "zh": "权杖Page"
    },
    {
      "id": "minor-权杖-10.upright",
      "zh": "一个新鲜灵感或小消息出现，保持好奇去试。"
    },
    {
      "id": "minor-权杖-10.reversed",
      "zh": "三分钟热度或消息不靠谱。"
    },
    {
      "id": "minor-权杖-10.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-11.name",
      "zh": "权杖Knight"
    },
    {
      "id": "minor-权杖-11.upright",
      "zh": "行动力爆棚，适合一鼓作气推进重要事项。"
    },
    {
      "id": "minor-权杖-11.reversed",
      "zh": "鲁莽冲动或三分钟热度，需踩刹车。"
    },
    {
      "id": "minor-权杖-11.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
    },
    {
      "id": "minor-权杖-12.name",
      "zh": "权杖Queen"
    },
    {
      "id": "minor-权杖-12.upright",
      "zh": "发挥自信与魅力，用热情把人和事凝聚起来。"
    },
    {
      "id": "minor-权杖-12.reversed",
      "zh": "过度强势或情绪起伏，注意体恤他人。"
    },
    {
      "id": "minor-权杖-12.disclaimer",
      "zh": "塔罗内容仅供文化娱乐与自我反思参考，不构成决策依据。"
