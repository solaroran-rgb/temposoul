/** 星色 → CSS */
export function starTint(tint?: SkyStar['tint']): string {
  switch (tint) {
    case 'blue':
      return '#bcd4ff';
    case 'yellow':
      return '#fff3c4';
    case 'orange':
      return '#ffd2a0';
    case 'red':
      return '#ffb0a0';
    default:
      return '#ffffff';
  }
}
