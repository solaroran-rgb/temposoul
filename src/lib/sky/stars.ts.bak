/**
 * @file 亮星表与主要星座连线
 * 肉眼显著亮星（≈亮于2.5等）精选表，坐标为J2000近似值，精度满足首屏星座形状渲染。
 * 完整 Hipparcos 星表后续 P1 扩充。
 */

export interface SkyStar {
  /** 中文名（无则匿名星点） */
  name?: string;
  /** 赤经（度，J2000） */
  ra: number;
  /** 赤纬（度，J2000） */
  dec: number;
  /** 视星等 */
  mag: number;
  /** 色偏提示 */
  tint?: 'blue' | 'white' | 'yellow' | 'orange' | 'red';
}

