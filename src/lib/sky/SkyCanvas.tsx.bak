/**
 * @file 真实星空渲染器（Canvas 2D）
 * 背景：v4 概念图（星云+粒子人+荧光网格地面）；上层叠加真实天文星位。
 */
import { useEffect, useRef } from 'react';
import { equatorialToHorizontal, localSiderealTime, toJulianDay, type Observer } from './astro';
import { BRIGHT_STARS, CONSTELLATION_LINES, starTint } from './stars';

export interface SkyViewProps {
  observer: Observer;
  date: Date;
  fullscreen?: boolean;
  className?: string;
}

let bgImage: HTMLImageElement | null = null;
let bgReady = false;
function ensureBg(): HTMLImageElement {
  if (bgImage) return bgImage;
  bgImage = new Image();
  bgImage.src = '/sky-hero-v4.png';
  bgImage.onload = () => { bgReady = true; };
  bgImage.onerror = () => { bgReady = false; };
  return bgImage;
}

export function SkyCanvas({ observer, date, fullscreen = false, className }: SkyViewProps) {
  const ref = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ensureBg();
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0;

    function resize() {
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = Math.max(1, Math.floor(w * DPR));
      canvas!.height = Math.max(1, Math.floor(h * DPR));
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      draw();
    }

    function project(alt: number, az: number): { x: number; y: number } | null {
      if (alt < 0) return null;
      const horizonY = h * 0.78;
      const x = (az / 360) * w;
      const t = Math.pow(alt / 90, 0.75);
      const y = horizonY - t * horizonY * 0.96;
      return { x, y };
    }

    function draw() {
      const c = ctx!;
      c.clearRect(0, 0, w, h);

      // 背景
      const bg = c.createLinearGradient(0, 0, 0, h);
      bg.addColorStop(0, '#04070f');
      bg.addColorStop(1, '#06101e');
      c.fillStyle = bg;
      c.fillRect(0, 0, w, h);

      // v4 概念图（cover 铺满）——图本身含星空/星座/月亮/城市山河/人物
      if (bgReady && bgImage) {
        const iw = bgImage.width, ih = bgImage.height;
        const scale = Math.max(w / iw, h / ih);
        const dw = iw * scale, dh = ih * scale;
        c.drawImage(bgImage, (w - dw) / 2, (h - dh) / 2, dw, dh);
      }
    }

    resize();
    window.addEventListener('resize', resize);
    const t = window.setTimeout(() => { bgReady && draw(); }, 300);
    return () => {
      window.removeEventListener('resize', resize);
      window.clearTimeout(t);
    };
  }, [observer.latitude, observer.longitude, date.getTime(), fullscreen]);

  return <canvas ref={ref} id="sky-canvas" className={className} aria-hidden="true" />;
}
