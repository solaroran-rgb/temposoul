{
    "name":  "temposoul",
    "private":  true,
    "version":  "0.3.0",
    "type":  "module",
    "packageManager":  "pnpm@11.9.0",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "pnpm --filter @temposoul/core build \u0026\u0026 pnpm lint:content \u0026\u0026 tsc -b \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "build:char-index":  "tsx --tsconfig tsconfig.app.json scripts/build-char-index.ts",
                    "test":  "pnpm --filter @temposoul/core build \u0026\u0026 tsx --tsconfig tsconfig.app.json --test \"tests/*.test.ts\"",
                    "test:core":  "pnpm --filter @temposoul/core test",
                    "test:api":  "pnpm --filter @temposoul/core build \u0026\u0026 tsx --tsconfig tsconfig.app.json --test tests/public-api.test.ts tests/public-api-docs.test.ts tests/node-request-body.test.ts",
                    "test:prompt":  "pnpm --filter @temposoul/core build \u0026\u0026 tsx --tsconfig tsconfig.app.json --test tests/prompt-evidence.test.ts tests/fortune-selection.test.ts tests/bazi-ai-prompt.test.ts tests/ziwei-prompt-snapshot.test.ts tests/astrolabe-scope.test.ts tests/divination-prompt-structure.test.ts tests/divination-engine.test.ts",
                    "test:mcp":  "pnpm --filter @temposoul/core build \u0026\u0026 pnpm test:e2e",
                    "test:e2e":  "tsx --tsconfig tsconfig.app.json --test --test-concurrency=1 \"tests/mcp/*.test.ts\"",
                    "package:check":  "pnpm --filter @temposoul/core build \u0026\u0026 node scripts/test-package-tarballs.mjs",
                    "lint":  "eslint src packages/core/src --max-warnings 999",
                    "lint:fix":  "eslint src packages/core/src --fix --max-warnings 999",
                    "format":  "prettier --write \"src/**/*.{ts,tsx}\" \"packages/core/src/**/*.ts\" \"packages/core/scripts/**/*.mjs\" \"tests/**/*.ts\" \"build/**/*.ts\"",
                    "format:check":  "prettier --check \"src/**/*.{ts,tsx}\" \"packages/core/src/**/*.ts\" \"packages/core/scripts/**/*.mjs\" \"tests/**/*.ts\" \"build/**/*.ts\"",
                    "prompt:check":  "pnpm test:prompt \u0026\u0026 pnpm prompt:audit",
                    "prompt:audit":  "tsx --tsconfig tsconfig.app.json scripts/generate-prompt-audit.ts",
                    "contest:evaluate":  "node scripts/evaluate-fortune-contest-model.js",
                    "mcp":  "tsx --tsconfig mcp/tsconfig.json mcp/src/server.ts",
                    "core:build":  "pnpm --filter @temposoul/core build",
                    "core:test":  "pnpm test:core",
                    "check:location-data":  "pnpm --filter @temposoul/core check:location-data",
                    "check:location-data:source":  "pnpm --filter @temposoul/core check:location-data:source",
                    "lint:content":  "node scripts/lint-content.mjs",
                    "gen:content":  "node scripts/gen-content-skeleton.mjs \u0026\u0026 node scripts/gen-names-skeleton.mjs",
                    "build:smoke-exp":  "tsx --tsconfig tsconfig.app.json scripts/build-smoke-expectations.ts",
                    "smoke":  "node scripts/smoke-runner.mjs",
                    "verify:merkle":  "node scripts/verify-merkle.mjs",
                    "freeze:artifacts":  "tsx --tsconfig tsconfig.app.json scripts/freeze-artifacts.ts",
                    "validate:routes":  "tsx --tsconfig tsconfig.app.json scripts/validate-routes.ts"
                },
    "dependencies":  {
                         "@temposoul/core":  "workspace:*",
                         "celestine":  "^0.2.1",
                         "fuse.js":  "^7.5.0",
                         "iztro":  "^2.5.8",
                         "marked":  "^16.4.2",
                         "react":  "^19.1.1",
                         "react-dom":  "^19.1.1",
                         "react-router-dom":  "^7.9.4",
                         "three":  "^0.186.0",
                         "tyme4ts":  "^1.3.3"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@modelcontextprotocol/sdk":  "^1.29.0",
                            "@types/node":  "^24.6.0",
                            "@types/react":  "^19.1.12",
                            "@types/react-dom":  "^19.1.9",
                            "@types/three":  "^0.186.0",
                            "@vitejs/plugin-react":  "^5.0.2",
                            "cnchar":  "3.2.6",
                            "cnchar-trad":  "3.2.6",
                            "eslint":  "^10.3.0",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-prettier":  "^5.5.5",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.2",
                            "hanzi":  "3.2.0",
                            "pinyin-pro":  "3.29.4",
                            "pixelmatch":  "^7.2.0",
                            "playwright":  "^1.63.0",
                            "pngjs":  "^7.0.0",
                            "prettier":  "^3.8.3",
                            "tsx":  "^4.21.0",
                            "typescript":  "^5.9.2",
                            "typescript-eslint":  "^8.59.3",
                            "vite":  "^7.1.7",
                            "zod":  "^4.4.3"
                        }
}