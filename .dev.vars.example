# AI 解析功能环境变量
# 复制此文件为 .dev.vars 后填入真实值
# Cloudflare Pages 部署时在 Dashboard → Settings → Environment variables 中配置同样的变量
#
# 注意：仅配置 AI_API_KEY 不会自动显示前端内置 AI。
# 需要显式设置 AI_BUILTIN_ENABLED=true，才显示并允许使用服务端 AI。
# AI_DEFAULT_ENABLED 只控制页面是否默认进入 AI 解读；公益服务不稳定时建议保持 false。

# API Key（填写你的 AI 服务商密钥）
# 支持任何 OpenAI 兼容接口，如 DeepSeek、千问、豆包、Groq、OpenAI 等
AI_API_KEY=your-api-key

# 接口地址（保持 /v1 结尾，默认 https://api.deepseek.com/v1）
AI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（默认 deepseek-chat，可按服务商修改，如 gpt-4o-mini、qwen-turbo 等）
AI_MODEL=deepseek-chat

# 前端显示的服务端 AI 名称（可选）
# AI_PROVIDER_NAME=DeepSeek

# 是否显示并允许使用内置 AI（可选，默认 false）
# AI_BUILTIN_ENABLED=true

# 页面是否默认打开 AI 解读（可选，默认 false）
# AI_DEFAULT_ENABLED=false

# ── 隐私友好分析（可选，默认关闭）──
# 仅当显式配置 ANALYTICS_PROVIDER 时启用；合规铁律：默认不采集。
# provider 取值：plausible | umami | ga（留空或 none 则关闭）
# ANALYTICS_PROVIDER=plausible
# Plausible：ANALYTICS_URL=https://plausible.io/js/script.js ANALYTICS_SITE_ID=your-domain.com
# Umami：  ANALYTICS_URL=https://umami.your-domain.com/script.js ANALYTICS_SITE_ID=your-website-id
# GA：     ANALYTICS_SITE_ID=G-XXXXXXXXXX

# ── 账户认证（可选，CF KV + 边缘函数）──
# 需在 Cloudflare Pages → Functions → KV 命名空间绑定 AUTH_KV，并配置 AUTH_SECRET。
# 本地 vite dev 不执行 functions/api/auth/*，认证端点返回 503（客户端优雅降级）。
# AUTH_ENABLED=true
# AUTH_SECRET=请生成强随机密钥（如 openssl rand -hex 32）
# 同时在 Cloudflare 控制台创建 KV 命名空间并命名为 AUTH_KV 后绑定到本 Pages 项目。

# ── 邮件发送（Resend，事务邮件）──
# 账号到位后填这些变量即激活 newsletter 双确认发信；留空则静默不发（只收集）。
# RESEND_API_KEY=re_xxxxxxxxxxxx        # 机密，wrangler secret put RESEND_API_KEY
# MAIL_FROM=TempoSoul <noreply@your-domain.com>   # 须已在 Resend 验证发信域名
# MAIL_FROM_NAME=TempoSoul 命律
# PUBLIC_SITE_URL=https://your-domain.com         # 可选，用于拼接确认链接；缺省取请求 origin
#
# ── 邮件队列调度（T03 五流调度器）──
# 未配 RESEND_API_KEY/MAIL_FROM 时调度器走 mock 日志（前缀 [mail-mock]），不发真实邮件；
# 配齐后自动切 Resend 真实发送，业务代码零改动。
# MAIL_DISPATCH_TOKEN=请生成强随机串（openssl rand -hex 32）  # 调度端点鉴权；未配则端点 503
# 定时触发：Cron Triggers / UptimeRobot / GitHub Actions schedule 每 1~5 分钟 POST
#          /api/v1/mail/dispatch  并带请求头 x-dispatch-token: <上面的 token>

# ── 支付（主 Lemon Squeezy / 备选 PayPal 接口预留）──
# 选型：Lemon Squeezy 为主（MoR，个人可注册、无公司要求），PayPal 备选接口已抽象预留。
# 开关：PAYMENT_PROVIDER=lemonsqueezy | paypal | 空(=关闭)。账号到位填下列变量即激活。
# PAYMENT_PROVIDER=lemonsqueezy
#
# ── Lemon Squeezy（主实现）──
# LEMONSQUEEZY_API_KEY=...            # 机密，Dashboard → API 新建 token
# LEMONSQUEEZY_STORE_ID=12345        # 数字 store id
# LEMONSQUEEZY_VARIANT_ID=67890      # 数字 variant id（订阅 recurring 产品）
# LEMONSQUEEZY_WEBHOOK_SECRET=...    # 机密，Webhook 端点 https://<域名>/api/v1/ls-webhook 创建后下发
# LEMONSQUEEZY_API_URL=https://api.lemonsqueezy.com/v1   # 可选
#
# ── PayPal（备选预留，暂未实现）──
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...            # 机密
